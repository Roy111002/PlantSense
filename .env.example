HOST=0.0.0.0
PORT=5000

# Use models/current when training and inference happen on the same machine.
PLANTSENSE_MODEL_DIR=models/current

# For other machines, set a public Hugging Face model repository and the full
# 40-character commit hash printed by training/upload_model.py.
PLANTSENSE_MODEL_REPO=
PLANTSENSE_MODEL_REVISION=

# Keep blank for the generic healthy/abnormal model. This is only used by the
# optional multiclass disease model.
PLANT_CROP=

CLASSIFIER_MIN_CONFIDENCE=0.65
CLASSIFIER_MIN_MARGIN=0.10
